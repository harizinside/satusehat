{
  "name": "@harizinside/satusehat",
  "version": "0.1.4",
  "description": "SATU SEHAT (Kemkes) Platform SDK for Node.js (TypeScript, ESM, zero runtime dependencies)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icd10": {
      "types": "./dist/fhir/coding/icd10.d.ts",
      "default": "./dist/fhir/coding/icd10.js"
    },
    "./icd9cm": {
      "types": "./dist/fhir/coding/icd9cm.d.ts",
      "default": "./dist/fhir/coding/icd9cm.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "generate": "node scripts/generate-modules.mjs",
    "generate:icd": "node scripts/generate-icd.mjs",
    "smoke": "node scripts/smoke.mjs",
    "hpke-check": "node scripts/hpke-check.mjs",
    "hpke-interop": "node scripts/hpke-interop.mjs",
    "bind-check": "node scripts/bind-check.mjs",
    "check:ts-compat": "for v in 5.1 5.9 6.0; do echo \"tsc $v\"; npx -y -p typescript@$v tsc -p tsconfig.compat.json || exit 1; done",
    "check:jsr": "npx --yes jsr publish --dry-run --allow-dirty"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "satusehat",
    "satu-sehat",
    "kemkes",
    "fhir",
    "r4",
    "indonesia",
    "health"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harizinside/satusehat.git"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2"
  }
}
